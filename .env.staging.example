# Copy to a git-ignored .env.staging, replace every remaining instructional
# value, then export the file as documented in docs/integration/staging-operations.md.
STAGING_ENVIRONMENT=staging
STAGING_PRODUCT_D1_ID=replace-with-real-product-d1-uuid
STAGING_AUTH_D1_ID=replace-with-real-auth-d1-uuid
STAGING_OPERATOR_ORIGIN=https://operator.staging.wastd.dev
STAGING_API_ORIGIN=https://api.staging.wastd.dev
STAGING_PASSKEY_RP_ID=operator.staging.wastd.dev
STAGING_ALLOWED_RECIPIENTS='["replace-with-real-recipient@example.com"]'

# Retained only for owner-run secret upload and root bootstrap workflows.
# The protected staging runner never forwards these values to Wrangler.
AUTH_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=replace-with-staging-resend-api-key
RESEND_FROM='Identity Staging <replace-with-verified-sender@example.com>'

# Retained only for owner-run secret upload workflows. The protected staging
# runner never forwards this value to Wrangler.
OPERATOR_SELECTION_SECRET=replace-with-at-least-32-random-characters
