{
  "name": "@incentives/operator-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @incentives/contracts build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @incentives/contracts build",
    "test": "vitest run",
    "lint": "oxlint src test",
    "predev:local": "pnpm --filter @incentives/contracts build && pnpm --filter @incentives/dashboard build",
    "dev:local": "wrangler dev --config wrangler.toml",
    "predev:staging": "pnpm --filter @incentives/contracts build && pnpm --filter @incentives/dashboard build",
    "dev:staging": "node ../../scripts/staging-wrangler-runner.mjs operator-web dev",
    "predeploy:staging": "pnpm --filter @incentives/contracts build && pnpm --filter @incentives/dashboard build",
    "deploy:staging": "node ../../scripts/staging-wrangler-runner.mjs operator-web deploy"
  },
  "dependencies": {
    "@incentives/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260717.1",
    "@types/node": "24.13.2",
    "oxlint": "1.69.0",
    "typescript": "6.0.2",
    "wrangler": "4.112.0",
    "vitest": "4.1.10"
  }
}
