#!/usr/bin/expect -f
log_user 0
set timeout 90
if {$argc != 4} { exit 20 }
set node_path [lindex $argv 0]
set wrangler_path [lindex $argv 1]
set store_id [lindex $argv 2]
set secret_name [lindex $argv 3]
if {[gets stdin secret_value] < 1} { exit 21 }
spawn -noecho $node_path $wrangler_path secrets-store secret create $store_id --name $secret_name --scopes workers --remote
expect {
  -re {Enter a secret value} { send -- "$secret_value\r" }
  -re {Select an account} { exit 26 }
  timeout { exit 22 }
  eof { exit 23 }
}
unset secret_value
expect {
  -re {Select an account} { exit 26 }
  eof {
    set result [wait]
    if {[lindex $result 2] != 0 || [lindex $result 3] != 0} { exit 24 }
    exit 0
  }
  timeout { exit 25 }
}
